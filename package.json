{
  "name": "dsh-plugin-zcode-loop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embed the vendored ZCode AgentRuntime as a dsh agent loop (prototype).",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm -r build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cold-start": "tsx scripts/cold-start.ts",
    "verify:facade": "node scripts/assert-facade-isolation.mjs",
    "verify": "pnpm verify:facade && pnpm cold-start",
    "verify:projection": "tsx scripts/projection-integration.ts",
    "verify:pipeline": "tsx scripts/pipeline-integration.ts",
    "verify:smoke": "node scripts/smoke.mjs",
    "verify:source-fidelity": "tsx scripts/source-fidelity-integration.ts",
    "verify:goal-chain": "tsx scripts/goal-chain-integration.ts",
    "verify:matrix": "tsx scripts/verify-matrix.ts",
    "verify:contracts:selftest": "tsx scripts/contract-verification/selftest.ts",
    "verify:classify": "tsx scripts/contract-verification/classify.ts",
    "verify:classify:selftest": "tsx scripts/contract-verification/classify-selftest.ts"
  },
  "dependencies": {
    "@zcode/contracts": "workspace:*",
    "@zcode/core": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-goal": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-goal": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
