{
  "name": "dsh-plugin-zcode-loop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embed the vendored ZCode AgentRuntime as a dsh agent loop (prototype).",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./file-checkpoints": {
      "types": "./dist/src/file-checkpoints.d.ts",
      "default": "./dist/src/file-checkpoints.js"
    },
    "./project-memory": {
      "types": "./dist/src/project-memory.d.ts",
      "default": "./dist/src/project-memory.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm -r build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cold-start": "tsx scripts/cold-start.ts",
    "verify:facade": "node scripts/assert-facade-isolation.mjs",
    "verify": "pnpm verify:facade && pnpm cold-start",
    "verify:projection": "tsx scripts/projection-integration.ts",
    "verify:inbox-projection": "tsx scripts/inbox-projection-integration.ts",
    "verify:request-provenance": "tsx scripts/request-provenance-integration.ts",
    "verify:step-boundary": "tsx scripts/step-boundary-integration.ts",
    "verify:model-config": "tsx scripts/model-config-integration.ts",
    "verify:history-compaction": "tsx scripts/history-compaction-integration.ts",
    "verify:crash-recovery": "tsx scripts/crash-recovery-integration.ts",
    "verify:agent-lifecycle": "tsx scripts/agent-lifecycle-integration.ts",
    "verify:pipeline": "tsx scripts/pipeline-integration.ts",
    "verify:smoke": "node scripts/smoke.mjs",
    "verify:source-fidelity": "tsx scripts/source-fidelity-integration.ts",
    "verify:goal-chain": "tsx scripts/goal-chain-integration.ts",
    "verify:goal-plan": "tsx scripts/goal-plan-integration.ts",
    "verify:tool-surface-context": "tsx scripts/tool-surface-context-integration.ts",
    "verify:tool-pathway": "tsx scripts/tool-pathway-integration.ts",
    "verify:attachments-media": "tsx scripts/attachments-media-integration.ts",
    "verify:preset-tools": "tsx scripts/preset-tools-integration.ts",
    "verify:extension-foundation": "tsx scripts/extension-foundation-integration.ts",
    "verify:subagent-sidechat": "tsx scripts/subagent-sidechat-integration.ts",
    "verify:branch-rerun": "tsx scripts/branch-rerun-integration.ts",
    "verify:file-checkpoints": "tsx scripts/file-checkpoints-integration.ts",
    "verify:project-memory": "tsx scripts/project-memory-integration.ts",
    "verify:workflow": "tsx scripts/workflow-integration.ts",
    "verify:jobs-schedule": "tsx scripts/jobs-schedule-integration.ts",
    "verify:runtime-seam": "tsx scripts/runtime-seam-integration.ts",
    "verify:matrix": "tsx scripts/verify-matrix.ts",
    "verify:contracts:selftest": "tsx scripts/contract-verification/selftest.ts",
    "verify:classify": "tsx scripts/contract-verification/classify.ts",
    "verify:classify:selftest": "tsx scripts/contract-verification/classify-selftest.ts",
    "verify:contracts": "tsx scripts/contract-verification/check.ts",
    "verify:contracts:status-selftest": "tsx scripts/contract-verification/status-selftest.ts",
    "verify:capabilities": "tsx scripts/contract-verification/capabilities.ts",
    "verify:capabilities:selftest": "tsx scripts/contract-verification/capabilities-selftest.ts"
  },
  "dependencies": {
    "@zcode/contracts": "workspace:*",
    "@zcode/core": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-file-reference": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-file-reference-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-goal": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-schedule": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-spill-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-spill-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-storage-json": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-goal": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-schedule": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tool-workflow": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-workflow": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
